    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Test Simulation",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/test_sim.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Batch Simulation",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/batch_sim.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Game Manager",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/game_manager.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Flask App",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/run.py",
            "console": "integratedTerminal"
        }
    ]
}